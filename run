#!/bin/sh
# One entrypoint for this project. Every command a person or an agent runs goes
# through here: one place to look, one thing to allowlist, one thing that can't
# drift from what SPEC.md claims the commands are.
set -eu

# A gate that passes stamps .work/gates/<task>.stamp. The commit hook compares
# those stamps against the files being committed and refuses a commit the fast
# gate never saw — gate output older than the code it is quoted as proving is not
# evidence.
stamp() {
  mkdir -p .work/gates
  date -u +%Y-%m-%dT%H:%M:%SZ > ".work/gates/$1.stamp"
}

# One line in .work/JOURNAL.md, the project's record of what was tested. A gate run
# with the same result as the line just above it adds nothing, so the builder's
# inner loop of fast-gate reruns does not bury everything else.
journal() {
  file=.work/JOURNAL.md
  [ -f "$file" ] || return 0
  last=$(grep -v '^[[:space:]]*$' "$file" | tail -n 1)
  case "$last" in "- ${1%% (*}"*) return 0 ;; esac
  [ -z "$(tail -c 1 "$file")" ] || echo >> "$file"
  printf -- '- %s\n' "$1" >> "$file"
}

# gate <name> <command...>
# Runs one gate with its output shown as it goes. A filtered run (./run fast -k name)
# proved a subset, not the gate, so it neither stamps nor writes to the journal. A
# full run stamps when it passes, and journals either way with the last line the
# command printed — for most test runners, the count.
gate() {
  name=$1; shift
  if [ "$filtered" -gt 0 ]; then "$@"; return; fi
  mkdir -p .work/gates
  log=".work/gates/$name.log"
  rm -f "$log.code"
  started=$(date +%s)
  { "$@" && echo 0 > "$log.code" || echo $? > "$log.code"; } 2>&1 | tee "$log"
  code=$(cat "$log.code" 2>/dev/null || echo 1)
  took=$(( $(date +%s) - started ))
  if [ "$code" -eq 0 ]; then result=passed; stamp "$name"; else result=failed; fi
  said=$(grep -v '^[[:space:]]*$' "$log" | tail -n 1 | tr -d '\033' | cut -c1-160)
  journal "$name gate $result (${took}s): $said"
  return "$code"
}

usage() {
  cat <<'USAGE'
usage: ./run <task> [args]

  setup   install the pinned toolchain and the locked dependencies
  types   regenerate the dashboard's types from the API's description
  fast    the fast gate — under ~60s, no external services, no real data volume
  db      only the database tests, against a throwaway migrated Postgres
  full    the full gate — real size, real dependencies, allowed to be slow
  smoke   start the real entrypoint and prove it comes up
  image   build the container image:  ./run image <tag>
  memory  load five million rows in a container and print its peak memory (not a gate)
  check   syntax or lint one file:  ./run check path/to/file
USAGE
}

# Containers run on the Docker engine inside WSL, never Docker Desktop. Each gate
# gets its own compose project, host port and throwaway password, so a gate never
# touches a developer's database and no password is ever written down. The ports sit
# below 49152: above that is Windows' range for outgoing connections, and a gate lost
# two runs to "address already in use" when another program got there first.
stack_project=
stack_port=
stack_source_port=
stack_api_port=
stack_http_port=
stack_prom_port=
stack_password=
stack_key=

# The Docker engine: inside WSL on this Windows machine, the machine's own on a Linux CI runner.
# Decided once here, so the gate a person runs is the same gate a pull request runs.
if command -v wsl.exe > /dev/null 2>&1; then engine="wsl.exe -e"; else engine=; fi

compose() {
  $engine env POSTGRES_PASSWORD="$stack_password" UDP_PG_PORT="$stack_port" \
    UDP_SOURCE_PG_PORT="$stack_source_port" UDP_MOCK_API_PORT="$stack_api_port" \
    UDP_API_PORT="${stack_http_port:-8000}" UDP_PROM_PORT="${stack_prom_port:-9090}" \
    UDP_API_KEYS="${UDP_API_KEYS:-}" DEMO_SCHEDULE="${DEMO_SCHEDULE:-}" \
    docker compose -p "$stack_project" -f deploy/compose.yaml \
    --profile app --profile demo --profile monitoring --profile scale "$@"
}

# WSL shuts the distro down about 15 seconds after the last wsl.exe command ends,
# stopping every container with it — even while tests on Windows are still using
# the database. One idle wsl.exe session held open for the life of the stack
# keeps it up. Without WSL there is nothing to keep up.
keepalive_start() {
  [ -n "$engine" ] || return 0
  MSYS_NO_PATHCONV=1 wsl.exe -e sh -c \
    "echo \$\$ > /tmp/$stack_project.keepalive; exec sleep 86400" > /dev/null 2>&1 &
}

keepalive_stop() {
  [ -n "$engine" ] || return 0
  MSYS_NO_PATHCONV=1 wsl.exe -e sh -c \
    "kill \$(cat /tmp/$stack_project.keepalive) 2>/dev/null; rm -f /tmp/$stack_project.keepalive"
}

# stack_start <project> <platform pg port> [<source pg port> <mock api port> [<udp api port>
#   [<prometheus port>]]]
# With the extra ports it also starts the source database and the mock API, and
# exports the demo sources' variables for code running on Windows. The last two ports are
# where the platform's own API and Prometheus are published when a gate starts them.
stack_start() {
  stack_project=$1
  stack_port=$2
  stack_source_port=${3:-}
  stack_api_port=${4:-}
  stack_http_port=${5:-}
  stack_prom_port=${6:-}
  stack_password=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
  # One API key per stack, made the same way as the password and never written down anywhere
  # but the file Prometheus reads. No trailing newline: Prometheus sends the file as it is.
  stack_key=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
  mkdir -p .work/gates
  printf '%s' "$stack_key" > .work/gates/api.key
  UDP_API_KEYS=$stack_key
  UDP_API_KEY=$stack_key
  export UDP_API_KEYS UDP_API_KEY
  # 127.0.0.1, not localhost: from Windows, localhost tries IPv6 first, and IPv6
  # to a port published inside WSL hangs for two minutes instead of being refused.
  UDP_DATABASE_URL="postgresql://udp:$stack_password@127.0.0.1:$stack_port/udp"
  export UDP_DATABASE_URL
  keepalive_start
  if [ -z "$stack_source_port" ]; then
    compose up -d --wait postgres
    return
  fi
  DEMO_DB_URL="postgresql://source:$stack_password@127.0.0.1:$stack_source_port/source"
  DEMO_API_URL="http://127.0.0.1:$stack_api_port"
  DEMO_API_TOKEN=$stack_password
  export DEMO_DB_URL DEMO_API_URL DEMO_API_TOKEN
  compose up -d --wait postgres source-postgres mock-api
}

stack_stop() {
  compose down -v --remove-orphans > /dev/null 2>&1
  keepalive_stop
}

migrate() {
  uv run --locked udp migrate
}

fast_gate() {
  uv run --locked ruff check . &&
    uv run --locked ruff format --check . &&
    uv run --locked python -m mypy &&
    types_are_current &&
    checks_together "$@"
}

# pytest and mypy are started as `python -m ...`: Windows Application Control blocked the
# pytest.exe shim mid-slice, then the mypy.exe one ("os error 4551"), and the module form does
# not go through those files. Start any new tool the same way.
# The dashboard's checks and the Python tests have nothing to say to each other, so they run
# at the same time, which is what keeps the gate under two minutes; see SPEC for the measured
# figures. The gate's duration is dominated by the Python tests.
checks_together() {
  mkdir -p .work/gates
  npm --prefix frontend run --silent check > .work/gates/frontend.log 2>&1 &
  dashboard=$!
  code=0
  uv run --locked python -m pytest -q -m "not db" "$@" > .work/gates/pytest.log 2>&1 || code=$?
  wait "$dashboard" || code=1
  # The dashboard's output first, so the line the journal quotes is the test count.
  cat .work/gates/frontend.log .work/gates/pytest.log
  return "$code"
}

# The dashboard's types are generated from the API's own description and committed. Regenerate
# them into .work and compare: a renamed field then fails the gate instead of blanking a page.
types_are_current() {
  mkdir -p .work/gates/types
  uv run --locked udp openapi > .work/gates/openapi.json &&
    npm --prefix frontend run --silent types:gate > /dev/null &&
    cmp -s .work/gates/types/schema.ts frontend/src/api/schema.ts && return 0
  echo "the dashboard's types no longer match the API — run ./run types" >&2
  return 1
}

db_gate() {
  code=0
  stack_start udp-db 45434 &&
    migrate &&
    uv run --locked python -m pytest -q -m "db and not scale and not services" "$@" || code=$?
  stack_stop || true
  return "$code"
}

full_gate() {
  code=0
  stack_start udp-gate 45432 45442 45452 &&
    migrate &&
    compose build app migrate &&
    HYPOTHESIS_PROFILE=ci uv run --locked python -m pytest -q "$@" || code=$?
  stack_stop || true
  return "$code"
}

SMOKE_SOURCES="demo_csv demo_excel demo_db demo_api"

# migrate is built with app every time: compose gives it an image of its own, which down -v
# keeps, so a migrate image left from an older smoke would apply older migrations.
smoke_sources() {
  compose build app migrate || return
  for source in $SMOKE_SOURCES; do
    compose run --rm app run "$source" || return
  done
  for source in $SMOKE_SOURCES; do
    uv run --locked udp run "$source" || return
  done
  smoke_scheduler && smoke_api && smoke_dashboard && smoke_metrics && smoke_console &&
    smoke_backup && smoke_hold
}

# Everything under /api needs the stack's key; the dashboard's own pages and files do not.
api_curl() {
  curl -H "X-API-Key: $stack_key" "$@"
}

# The dashboard must come back from the same address as the API: its own addresses answer with
# the page, its built files with themselves, and anything under /api stays the API's.
smoke_dashboard() {
  base="http://127.0.0.1:$stack_http_port"
  page=$(curl -fsS "$base/") || return
  printf '%s' "$page" | grep -q 'id="root"' || { echo "the dashboard page has no root"; return 1; }
  asset=$(printf '%s' "$page" | sed -n 's/.*src="\(\/assets\/[^"]*\.js\)".*/\1/p' | head -n 1)
  [ -n "$asset" ] || { echo "the dashboard page names no script"; return 1; }
  curl -fsS -o /dev/null "$base$asset" || return
  curl -fsS "$base/datasets/demo_csv/customers" | grep -q 'id="root"' ||
    { echo "a dataset address does not return the dashboard"; return 1; }
  api_curl -s -o /dev/null -w '%{http_code}' "$base/api/nope" | grep -q '^404$' ||
    { echo "an unknown api address is not a 404"; return 1; }
  echo "dashboard served at $base$asset"
}

# The api's metrics must be Prometheus text, and a real Prometheus must scrape them: its own
# query page has to report the api target up and return at least one run series.
smoke_metrics() {
  metrics=$(api_curl -fsS "http://127.0.0.1:$stack_http_port/api/metrics") || return
  for name in udp_build_info 'udp_runs_total{'; do
    printf '%s' "$metrics" | grep -qF "$name" || { echo "the metrics have no $name"; return 1; }
  done
  compose up -d --wait prometheus || { compose logs prometheus; return 1; }
  query="http://127.0.0.1:$stack_prom_port/api/v1/query"
  deadline=$(( $(date +%s) + 60 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    up=$(curl -fsS -G "$query" --data-urlencode 'query=up{job="udp"}' || true)
    runs=$(curl -fsS -G "$query" --data-urlencode 'query=udp_runs_total > 0' || true)
    case "$up" in
      *'"value":['*',"1"]'*)
        case "$runs" in
          *'"metric":{'*) echo "prometheus up: $up"; echo "prometheus runs: $runs" | cut -c1-400
            return 0 ;;
        esac ;;
    esac
    sleep 2
  done
  compose logs prometheus
  echo "prometheus did not report the api up with run series within 60s"
  return 1
}

# Every dashboard page is opened in headless chromium, and any console error, uncaught page
# error or failed request fails the smoke. Chromium is downloaded once, only where smoke runs.
smoke_console() {
  npx --prefix frontend playwright install chromium > /dev/null || return
  node frontend/e2e/console-check.mjs "http://127.0.0.1:$stack_http_port"
}

# A backup nobody has restored is a hope, not a backup. The platform database is dumped,
# restored into a second database beside it, compared row for row, and then run against: an
# unchanged file must load nothing, which only holds if the saved state came back too.
smoke_backup() {
  # MSYS_NO_PATHCONV: without it Git Bash turns the container's /tmp path into a Windows one.
  dump=/tmp/udp-smoke.dump
  psql="compose exec -T postgres psql -U udp -tAX"
  MSYS_NO_PATHCONV=1 compose exec -T postgres pg_dump -U udp -Fc -f "$dump" udp || return
  $psql -d postgres -c 'DROP DATABASE IF EXISTS udp_restored' > /dev/null || return
  $psql -d postgres -c 'CREATE DATABASE udp_restored OWNER udp' > /dev/null || return
  MSYS_NO_PATHCONV=1 compose exec -T postgres pg_restore -U udp -d udp_restored "$dump" || return
  runs_query="SELECT count(*) FROM platform.pipeline_runs"
  rows_query="SELECT md5(string_agg(t::text, ',' ORDER BY t::text)) FROM datasets.demo_csv__customers AS t"
  for query in "$runs_query" "$rows_query"; do
    before=$($psql -d udp -c "$query") || return
    after=$($psql -d udp_restored -c "$query") || return
    [ "$before" = "$after" ] || {
      echo "the restored database disagrees: '$before' became '$after'"
      return 1
    }
    echo "restored and matching: $before"
  done
  # The restored copy is a working platform, not only a pile of rows.
  restored_run=$(UDP_DATABASE_URL="postgresql://udp:$stack_password@127.0.0.1:$stack_port/udp_restored" \
    uv run --locked udp run demo_csv 2>&1) || {
    printf '%s\n' "$restored_run"
    echo "a run against the restored database failed"
    return 1
  }
  printf '%s\n' "$restored_run"
  printf '%s' "$restored_run" | grep -q 'file unchanged, skipped' &&
    printf '%s' "$restored_run" | grep -q '"rows_loaded": 0' || {
    echo "the run against the restored database did not skip the unchanged file"
    return 1
  }
}

# With SMOKE_HOLD=1 the stack stays up so the pages can be opened with the browser tool.
smoke_hold() {
  [ "${SMOKE_HOLD:-}" = "1" ] || return 0
  rm -f .work/gates/smoke.release
  echo "dashboard ready: http://127.0.0.1:$stack_http_port/"
  deadline=$(( $(date +%s) + 600 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    [ -f .work/gates/smoke.release ] && { echo "released"; return 0; }
    sleep 2
  done
  echo "nobody released the stack within 600s"
  return 0
}

# The api container must answer from Windows on its 127.0.0.1-only port, list the demo
# datasets, and run demo_excel on request; the finished run's line is printed last.
smoke_api() {
  compose build api && compose up -d --wait api || { compose logs api; return 1; }
  base="http://127.0.0.1:$stack_http_port/api"
  # The health check is the one address left open, because the container's own probe uses it.
  curl -fsS "$base/health" && echo || return
  curl -s -o /dev/null -w '%{http_code}' "$base/datasets" | grep -q '^401$' ||
    { echo "the api answered a request that carried no key"; return 1; }
  api_curl -fsS "$base/datasets?q=demo_" | grep -q '"dataset":"customers"' ||
    { echo "the api does not list demo_csv customers"; return 1; }
  api_curl -fsS -o /dev/null "$base/docs" || return
  accepted=$(api_curl -fsS -X POST -H 'Content-Type: application/json' \
    -d '{"source":"demo_excel"}' "$base/runs") || return
  echo "$accepted"
  requested=$(printf '%s' "$accepted" | sed -n 's/.*"requested_at":"\([^"]*\)".*/\1/p')
  deadline=$(( $(date +%s) + 60 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    runs=$(api_curl -fsS -G "$base/runs" --data-urlencode "source=demo_excel" \
      --data-urlencode "trigger=manual" --data-urlencode "since=$requested") || return
    case "$runs" in
      *'"status":"succeeded"'*) printf '%s\n' "$runs" | cut -c1-400; return 0 ;;
      *'"status":"failed"'*|*'"status":"skipped"'*) printf '%s\n' "$runs"; compose logs api; return 1 ;;
    esac
    sleep 1
  done
  compose logs api
  echo "the run requested over the api did not succeed within 60s"
  return 1
}

# The scheduler container must start a scheduled run of demo_csv (every minute) and
# finish it; its first "run finished" line decides, printed so the journal quotes it.
smoke_scheduler() {
  compose build scheduler && compose up -d scheduler || return
  deadline=$(( $(date +%s) + 90 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    logs=$(compose logs --no-log-prefix scheduler 2>/dev/null || true)
    finished=$(printf '%s\n' "$logs" | grep '"event": "run finished"' | head -n 1 || true)
    case "$finished" in
      *'"status": "succeeded"'*) printf '%s\n' "$finished"; return 0 ;;
      *'"status": '*) printf '%s\n' "$logs"; return 1 ;;
    esac
    sleep 1
  done
  compose logs scheduler
  echo "the scheduler finished no run within 90s"
  return 1
}

# Not a gate, and never in one: loads five million rows inside the app image with a memory
# limit and reads the container's own peak, because Python cannot see what Polars allocates
# natively and Windows has no portable peak-memory reading. Run by hand, once per milestone.
MEMORY_LIMIT_BYTES=1073741824

memory_run() {
  rows=${1:-5000000}
  mkdir -p .work/gates .work/scale
  log=.work/gates/memory.log
  code=0
  uv run --locked python tests/scale_csv.py .work/scale "$rows" &&
    stack_start udp-memory 45435 &&
    migrate &&
    compose build scale-load migrate &&
    { compose run --rm --entrypoint sh scale-load -c \
      'udp run scale_csv --full-refresh; ran=$?; echo "peak_bytes $(cat /sys/fs/cgroup/memory.peak)"; exit $ran' \
      && echo 0 > "$log.code" || echo $? > "$log.code"; } 2>&1 | tee "$log"
  code=$(cat "$log.code" 2>/dev/null || echo 1)
  stack_stop || true
  peak=$(grep 'peak_bytes' "$log" | tail -n 1 | tr -dc '0-9')
  [ -n "$peak" ] || { echo "the container printed no peak memory"; return 1; }
  echo "peak memory: $(( peak / 1024 / 1024 )) MiB loading $rows rows (limit $(( MEMORY_LIMIT_BYTES / 1024 / 1024 )) MiB)"
  [ "$code" -eq 0 ] || return "$code"
  [ "$peak" -le "$MEMORY_LIMIT_BYTES" ] || { echo "over the memory target"; return 1; }
}

# No migrate from this machine here: the stack starts on an empty database, and the first
# container run must create the platform tables through compose's migrate service alone.
smoke_gate() {
  code=0
  # Only here: the scheduler check needs demo_csv to run every minute, and setting it for
  # every stack would leave the full gate's pytest reading a scheduled demo_csv as well.
  DEMO_SCHEDULE="* * * * *"
  export DEMO_SCHEDULE
  stack_start udp-smoke 45433 45443 45453 45463 45473 &&
    smoke_sources || code=$?
  stack_stop || true
  return "$code"
}

task="${1:-}"
[ $# -gt 0 ] && shift
filtered=$#

case "$task" in
  # Browsers for the console check are fetched by the smoke itself, never by setup.
  setup) uv sync --frozen && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci --prefix frontend ;;
  image)
    [ -n "${1:-}" ] || { echo "usage: ./run image <tag>" >&2; exit 1; }
    $engine docker build -f deploy/Dockerfile -t "$1" .
    ;;
  types)
    mkdir -p .work/gates
    uv run --locked udp openapi > .work/gates/openapi.json &&
      npm --prefix frontend run types
    ;;
  fast)  gate fast fast_gate "$@" ;;
  db)    gate db db_gate "$@" ;;
  full)  gate full full_gate "$@" ;;
  smoke) gate smoke smoke_gate ;;
  memory) memory_run "$@" ;;
  check)
    # One file, checked after an edit. `uvx` runs ruff on its own instead of out of .venv:
    # this is called from the editor's own hook, which on Windows is not the platform .venv
    # was built for, and `uv run` there tries to replace it and leaves it half deleted. The
    # version is pinned to the one in uv.lock so this says exactly what the gate says.
    case "${1:-}" in
      *.py) uvx ruff@0.16.7 check "$1" ;;
      *) ;;
    esac
    ;;
  ""|-h|--help|help) usage ;;
  *) echo "run: unknown task '$task'" >&2; usage >&2; exit 1 ;;
esac
