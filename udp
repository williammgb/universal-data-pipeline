#!/bin/sh
# The platform's one command, without the `uv run --locked` prefix:
#
#   ./udp up [--demo]              start the platform in containers (with the demo sources),
#                                  then print the dashboard's address
#   ./udp run [--demo]             the same as up
#   ./udp down                     stop every container, keeping the data
#   ./udp status                   list the containers and their health
#   ./udp logs [<service>...] [-f] the last 100 log lines of every container, or of those named;
#                                  -f keeps following them
#   ./udp open                     open the dashboard in the browser
#   ./udp restart                  restart the API and the scheduler
#   ./udp backup                   dump the database to backups/udp-<yyyyMMdd-HHmmss>.dump
#   ./udp load <source>... --docker
#                                  load sources inside the running containers, building the
#                                  image first so the load runs the current code
#   ./udp <anything else>          the same as `uv run --locked udp <anything else>`
#
# With UDP_DRY_RUN=1 a container command prints the compose call instead of making it, and on
# standard error the names (never the values) of the variables it would pass on.
set -eu
cd "$(dirname "$0")"
. deploy/engine.sh

# Compose sees only what is passed to it: through WSL, this shell's variables do not cross. A
# variable that is unset or empty here is left out, so deploy/.env can supply it: an empty value
# handed over would win over the file's.
compose() {
  called="docker compose -f deploy/compose.yaml $*"
  set -- docker compose -f deploy/compose.yaml "$@"
  passing=
  value=
  for name in POSTGRES_PASSWORD UDP_API_KEYS UDP_PG_PORT UDP_SOURCE_PG_PORT UDP_MOCK_API_PORT \
    UDP_API_PORT UDP_PROM_PORT DEMO_SCHEDULE; do
    # Only the fixed names above are ever handed to eval.
    eval "value=\${$name:-}"
    [ -n "$value" ] || continue
    set -- "$name=$value" "$@"
    passing="$passing $name"
  done
  if [ "${UDP_DRY_RUN:-}" = 1 ]; then
    echo "$called"
    echo "passing:$passing" >&2
    return
  fi
  $engine env COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-udp}" "$@"
}

# The dashboard's address: the port in this shell's UDP_API_PORT, else in deploy/.env, else 8000.
address() {
  port=${UDP_API_PORT:-}
  if [ -z "$port" ] && [ -f deploy/.env ]; then
    port=$(sed -n 's/^UDP_API_PORT=//p' deploy/.env | tail -n 1 | tr -d "\r\"'")
  fi
  echo "http://127.0.0.1:${port:-8000}"
}

case "${1:-}" in
  up | run)
    shift
    profiles=
    for arg in "$@"; do
      case "$arg" in
        --demo) profiles="--profile demo" ;;
        *) echo "usage: ./udp up [--demo]" >&2; exit 2 ;;
      esac
    done
    # The stack outlives this command, so the keepalive does too, until ./udp down. One left by
    # an earlier up is replaced, not doubled.
    if [ "${UDP_DRY_RUN:-}" != 1 ]; then keepalive_stop udp; keepalive_start udp infinity; fi
    # shellcheck disable=SC2086
    compose $profiles up -d --build --wait
    [ "${UDP_DRY_RUN:-}" = 1 ] || echo "Dashboard: $(address) (API key in deploy/.env)"
    ;;
  down)
    shift
    [ $# -eq 0 ] || { echo "usage: ./udp down" >&2; exit 2; }
    compose --profile app --profile demo --profile monitoring --profile scale down
    [ "${UDP_DRY_RUN:-}" = 1 ] || keepalive_stop udp
    ;;
  load)
    shift
    docker=0
    for arg in "$@"; do [ "$arg" = --docker ] && docker=1; done
    if [ "$docker" -eq 0 ]; then exec uv run --locked udp load "$@"; fi
    # Rebuild the argument list without --docker, keeping every other argument's spaces.
    for arg in "$@"; do
      shift
      [ "$arg" = --docker ] || set -- "$@" "$arg"
    done
    # `run` alone never rebuilds an image that exists, and `up` does not build this one.
    compose run --rm --build app load "$@"
    ;;
  status)
    shift
    compose --profile app --profile demo --profile monitoring --profile scale ps "$@"
    ;;
  logs)
    shift
    compose logs --tail 100 "$@"
    ;;
  restart)
    shift
    [ $# -eq 0 ] || { echo "usage: ./udp restart" >&2; exit 2; }
    compose restart api scheduler
    ;;
  backup)
    shift
    [ $# -eq 0 ] || { echo "usage: ./udp backup" >&2; exit 2; }
    dump="backups/udp-$(date +%Y%m%d-%H%M%S).dump"
    if [ "${UDP_DRY_RUN:-}" = 1 ]; then
      called=$(compose exec -T postgres pg_dump -U udp -Fc udp)
      echo "$called > $dump"
      exit 0
    fi
    # Written under a .part name, so a dump cut short is never mistaken for a whole one.
    mkdir -p backups
    if compose exec -T postgres pg_dump -U udp -Fc udp > "$dump.part"; then
      mv "$dump.part" "$dump"
      echo "Backup: $dump"
    else
      rm -f "$dump.part"
      exit 1
    fi
    ;;
  open)
    url=$(address)
    if [ "$(uname -s)" = Darwin ]; then
      set -- open "$url"
      shown="open $url"
    elif command -v xdg-open > /dev/null 2>&1; then
      set -- xdg-open "$url"
      shown="xdg-open $url"
    elif command -v cmd.exe > /dev/null 2>&1; then
      set -- cmd.exe /c start "" "$url"
      shown="cmd.exe /c start \"\" $url"
    else
      echo "Dashboard: $url"
      exit 0
    fi
    if [ "${UDP_DRY_RUN:-}" = 1 ]; then echo "$shown"; exit 0; fi
    # MSYS_NO_PATHCONV: without it Git Bash turns /c into a Windows path.
    MSYS_NO_PATHCONV=1 "$@"
    ;;
  *)
    exec uv run --locked udp "$@"
    ;;
esac
