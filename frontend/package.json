{
  "name": "udp-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && vitest run",
    "types": "openapi-typescript ../.work/gates/openapi.json -o src/api/schema.ts",
    "types:gate": "openapi-typescript ../.work/gates/openapi.json -o ../.work/gates/types/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.95.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.9.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "fast-check": "4.3.0",
    "jsdom": "27.0.0",
    "openapi-typescript": "7.9.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
